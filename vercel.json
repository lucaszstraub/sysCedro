{
  "version": 2,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci",
  "framework": null,
  "env": {
    "SYS_CEDRO_WEB": "1",
    "DB_HYBRID": "false",
    "DB_CLOUD": "true",
    "DB_SSL": "true",
    "DB_POOL_MAX": "1"
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/invoke.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{database/**,electron/**,server/**,assets/**,public/**}"
    },
    "api/health.js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{database/**,electron/**,server/**,assets/**,public/**}"
    }
  }
}
